{
  "manifest_version": 3,
  "name": "Spoke Route Bridge",
  "version": "1.2.0",
  "description": "Matches WhatsApp customer names to the master list and syncs Spoke dispatch routes.",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "contextMenus"]
}
